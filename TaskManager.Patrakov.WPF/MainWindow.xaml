<Window x:Class="TaskManager.Patrakov.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Менеджер задач - Патраков" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📋 Менеджер задач - Патраков" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" 
                Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TitleTextBox" Height="30" Margin="0,0,5,0"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Описание:" FontWeight="Bold" Margin="5,0,5,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DescriptionTextBox" Height="30" Margin="5,0,5,0"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Приоритет:" FontWeight="Bold" Margin="5,0,5,0"/>
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="PriorityComboBox" Height="30" Margin="5,0,5,0">
                    <ComboBoxItem Content="Низкий" Tag="Low"/>
                    <ComboBoxItem Content="Средний" Tag="Medium" IsSelected="True"/>
                    <ComboBoxItem Content="Высокий" Tag="High"/>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="Срок:" FontWeight="Bold" Margin="5,0,5,0"/>
                <DatePicker Grid.Row="1" Grid.Column="3" x:Name="DueDatePicker" Height="30" 
                            SelectedDate="{x:Static sys:DateTime.Now}" Margin="5,0,5,0"/>

                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" 
                        x:Name="AddButton" Content="➕ Добавить" 
                        Width="120" Height="60" Background="#4CAF50" Foreground="White"
                        Click="AddButton_Click" Margin="5,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" 
                Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Фильтр:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="1" x:Name="FilterComboBox" Height="30" 
                          SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Все задачи" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Новые" Tag="New"/>
                    <ComboBoxItem Content="В процессе" Tag="InProgress"/>
                    <ComboBoxItem Content="Завершены" Tag="Completed"/>
                    <ComboBoxItem Content="⭐ Важные" Tag="Important"/>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="Поиск:" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox Grid.Column="3" x:Name="SearchTextBox" Height="30" 
                         TextChanged="SearchTextBox_TextChanged"/>

                <Button Grid.Column="4" x:Name="SortPriorityButton" Content="⬆ По приоритету" 
                        Click="SortPriorityButton_Click" Margin="5,0,5,0"/>
                <Button Grid.Column="5" x:Name="SortDueDateButton" Content="📅 По сроку" 
                        Click="SortDueDateButton_Click"/>
            </Grid>
        </Border>

        <ListView Grid.Row="3" x:Name="TasksListView" Margin="0,0,0,10"
                  SelectionMode="Single" MouseDoubleClick="TasksListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="⭐" Width="30" DisplayMemberBinding="{Binding IsImportant}"/>
                    <GridViewColumn Header="Название" Width="200" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="Описание" Width="200" DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Приоритет" Width="80" DisplayMemberBinding="{Binding Priority}"/>
                    <GridViewColumn Header="Срок" Width="100" DisplayMemberBinding="{Binding DueDate, StringFormat=dd.MM.yyyy}"/>
                    <GridViewColumn Header="Статус" Width="100" DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1" 
                Padding="10" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatisticsText" Text="Всего: 0 | Завершено: 0 | Просрочено: 0" 
                           VerticalAlignment="Center" FontWeight="Bold"/>

                <Button Grid.Column="1" x:Name="EditButton" Content="✏️ Редактировать" 
                        Click="EditButton_Click" Margin="5,0"/>
                <Button Grid.Column="2" x:Name="DeleteButton" Content="🗑️ Удалить" 
                        Click="DeleteButton_Click" Margin="5,0" Background="#F44336" Foreground="White"/>
                <Button Grid.Column="3" x:Name="RefreshButton" Content="🔄 Обновить" 
                        Click="RefreshButton_Click" Margin="5,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>