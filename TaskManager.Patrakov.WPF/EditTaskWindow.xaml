<Window x:Class="TaskManager.Patrakov.WPF.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование задачи" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleTextBox" Height="30" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Описание:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DescriptionTextBox" Height="30" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Приоритет:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="PriorityComboBox" Height="30" Margin="0,0,0,5">
            <ComboBoxItem Content="Низкий" Tag="Low"/>
            <ComboBoxItem Content="Средний" Tag="Medium" IsSelected="True"/>
            <ComboBoxItem Content="Высокий" Tag="High"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Срок:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <DatePicker Grid.Row="3" Grid.Column="1" x:Name="DueDatePicker" Height="30" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Статус:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="StatusComboBox" Height="30" Margin="0,0,0,5">
            <ComboBoxItem Content="Новая" Tag="New" IsSelected="True"/>
            <ComboBoxItem Content="В процессе" Tag="InProgress"/>
            <ComboBoxItem Content="Завершена" Tag="Completed"/>
        </ComboBox>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Важная:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <CheckBox Grid.Row="5" Grid.Column="1" x:Name="ImportantCheckBox" Content="⭐ Отметить как важную" 
                  VerticalAlignment="Center" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="💾 Сохранить" Width="100" Height="35"
                    Background="#4CAF50" Foreground="White" Click="SaveButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="❌ Отмена" Width="100" Height="35"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>